pragma language_version >= 0.25;

import CompactStandardLibrary;

// Shared signet library: request/response structs, request-id hashing,
// request construction, and the attestation message. See the module header
// in Signet.compact for the protocol.
import "@sig-net/midnight/src/Signet";

// This is the central Sig Network contract on Midnight.
// Clients register emit signature-request notifications here via cross contract call.
// The MPC emits signature responses and respond-bidirectional responses from here.
//
// Every method here is unauthenticated by design to keep proving time as low as possible.
// Verification is deliberately the reader's job: 
// - MPC authenticates notifications by:
//   - confirming via the indexer that the transaction which emitted this notification event
//     also contains a contract call on the callerAddress named in the notification event.
//   - reading the event back from the named caller's own ledger and refusing entries
//     whose recomputed request id or sender does not match
// - Clients verify posted signatures and attestations themselves (off-chain or in their own circuits).

// signBidirectional should be called (cross-contract) by clients to notify the MPC
// that a SignBidirectionalEvent has been written to their canonical
// SignBidirectionalEventMap state map. The MPC does not trust the notification's
// content. It authenticates by:
//   (a) reading the event back from the named caller's own ledger and refusing entries
//       whose recomputed request id or sender does not match, and
//   (b) confirming via the indexer that the transaction which emitted this notification event
//       also contains a contract call on the callerAddress named in the notification event.
export circuit signBidirectional(
      requestId: RequestId,
      notification: SignBidirectionalEventNotification
): [] {
    assert(notification.version == 1, "only version 1 notification supported");

    emit (Misc {
        name: pad(32, "SignBidirectionalEvent"),
        payload: Bytes[
            disclose(notification.version),    //  1
            ...disclose(notification.payload), // +128
            ...default<Bytes<127>>             // +127
        ],                                     // = 256 bytes
    });
}

// respond emits the MPC's signature response as a SignatureRespondedEvent
// contract event. The event carries the signature alone, with no request id.
// Callers poll the event log and verify each candidate off-chain: a post
// answers their request when its signature recovers to their derived key over
// that request's transaction.
export circuit respond(
    requestId: RequestId,
    signatureRespondedEvent: SignatureRespondedEvent,
): [] {
    emit (Misc {
        name: pad(32, "SignatureRespondedEvent"),
        payload: Bytes[
            ...disclose(signatureRespondedEvent.signature.bigR.x),  //  32
            ...disclose(signatureRespondedEvent.signature.bigR.y),  // +32
            ...disclose(signatureRespondedEvent.signature.s),       // +32
            disclose(signatureRespondedEvent.signature.recoveryId), // +1
            ...default<Bytes<159>>,                                 // +159            
        ],                                                          // = 256 bytes
    });
}

// respondBidirectional emits the MPC's respond-bidirectional response as a
// RespondBidirectionalEvent contract event: the ECDSA signature that attests
// the foreign transaction execution (never the digest or the output itself).
// Emitted unverified, with no request id. Callers poll the event log and
// verify each candidate themselves against their MPC response key (derived
// from the caller contract's address + the fixed path "midnight response
// key", see verifyRespondBidirectionalEvent in Signet.compact).
export circuit respondBidirectional(
    requestId: RequestId,
    respondBidirectionalEvent: RespondBidirectionalEvent
): [] {
    emit (Misc {
        name: pad(32, "RespondBidirectionalEvent"),
        payload: Bytes[
            ...disclose(respondBidirectionalEvent.signature.bigR.x),  //  32
            ...disclose(respondBidirectionalEvent.signature.bigR.y),  // +32
            ...disclose(respondBidirectionalEvent.signature.s),       // +32
            disclose(respondBidirectionalEvent.signature.recoveryId), // +1
            ...default<Bytes<159>>,                                   // +159            
        ],                                                            // = 256 bytes
    });
}
