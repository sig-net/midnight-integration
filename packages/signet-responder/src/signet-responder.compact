pragma language_version >= 0.25;

import CompactStandardLibrary;

// Shared signet library: the response structs. See the module header in
// Signet.compact for the protocol.
import "@sig-net/midnight/src/Signet";

// The Sig Network response contract: the circuits the MPC posts its responses
// through. Clients read their request's responses from the events they emit.
//
// This source is the specification and the JS executor. The published proving
// artifacts come from minocrab/, a MinoCrab implementation of these same
// circuits with a much smaller circuit, built only after each one accepts the
// MPC's call with the same public inputs as compactc's circuit. Change a
// circuit here and in minocrab/src/circuits.rs together.
//
// Every circuit is unauthenticated: posts are emitted unverified, and clients
// verify each candidate themselves.

// respond emits the MPC's signature response as a SignatureRespondedEvent
// contract event. The payload leads with the request id the post answers.
// The id is unauthenticated routing data: callers read their request's posts
// by id, then verify each candidate off-chain. A post answers a request only
// when its signature recovers to the caller's derived key over that request's
// transaction.
export circuit respond(
    signatureRespondedEvent: SignatureRespondedEventV1,
): [] {
    emit (Misc {
        name: pad(32, "SignatureRespondedEvent"),
        payload: Bytes[
            ...disclose(signatureRespondedEvent.requestId),         //  32
            ...disclose(signatureRespondedEvent.signature.bigR.x),  // +32
            ...disclose(signatureRespondedEvent.signature.bigR.y),  // +32
            ...disclose(signatureRespondedEvent.signature.s),       // +32
            disclose(signatureRespondedEvent.signature.recoveryId), // +1
            ...default<Bytes<127>>,                                 // +127
        ],                                                          // = 256 bytes
    });
}

// respondBidirectional emits the MPC's respond-bidirectional response as a
// RespondBidirectionalEvent contract event: the ECDSA signature that attests
// the foreign transaction's outcome (executed, failed or unviable), with the
// block height, output kind, output width and output hash it signs over and
// the digest it is over (never the output itself).
// The payload leads with the request id the post answers. The id is
// unauthenticated routing data, and the post is emitted unverified: callers
// read their request's posts by id and verify each candidate themselves
// against their MPC response key (derived from the caller contract's address
// + the fixed path "midnight response key", see
// verifyRespondBidirectionalEventV1 in Signet.compact).
export circuit respondBidirectional(
    respondBidirectionalEvent: RespondBidirectionalEventV1
): [] {
    emit (Misc {
        name: pad(32, "RespondBidirectionalEvent"),
        payload: Bytes[
            ...disclose(respondBidirectionalEvent.requestId),                            //  32
            ...(disclose(respondBidirectionalEvent.blockHeight) as Bytes<8>),            // +8, little-endian
            disclose(respondBidirectionalEvent.outputKind) as Uint<8>,                   // +1, the enum's variant index
            ...(disclose(respondBidirectionalEvent.serializedOutputLength) as Bytes<8>), // +8, little-endian
            ...disclose(respondBidirectionalEvent.outputHash),                           // +32
            ...disclose(respondBidirectionalEvent.digest),                               // +32
            ...disclose(respondBidirectionalEvent.signature.bigR.x),                     // +32
            ...disclose(respondBidirectionalEvent.signature.bigR.y),                     // +32
            ...disclose(respondBidirectionalEvent.signature.s),                          // +32
            disclose(respondBidirectionalEvent.signature.recoveryId),                    // +1
            ...default<Bytes<46>>,                                                       // +46
        ],                                                                               // = 256 bytes
    });
}
