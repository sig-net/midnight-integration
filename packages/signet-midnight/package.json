{
  "name": "@sig-net/midnight",
  "version": "0.21.0-rc.6",
  "repository": {
    "type": "git",
    "url": "https://github.com/sig-net/midnight-integration",
    "directory": "packages/signet-midnight"
  },
  "type": "module",
  "description": "Midnight-side sig-net integration: the seed of a future signet.js Midnight adapter.",
  "//exports": "Local dev consumes raw TS source. `publishConfig.exports` below swaps this to the emitted ./dist at publish time, so npm consumers get JS + .d.ts while the monorepo keeps resolving to src.",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "dist",
    "src/*.compact"
  ],
  "scripts": {
    "compile": "compact compile --skip-zk --feature-zkir-v3 src/circuits.compact src/managed",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.build.json && cp -R src/managed dist/managed",
    "prepack": "yarn build",
    "record-contract-address": "tsx record-contract-address.ts",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-beta.6",
    "@noble/curves": "^2.2.0",
    "@sig-net/midnight-serde": "^0.21.0-rc.6",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
