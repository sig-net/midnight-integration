{
  "name": "@midnight-protocol/midnight-serde-conformance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Compiler-backed evidence for the documented Compact-compatible Borsh subset.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "compile": "node --import tsx src/compile.ts",
    "generate": "node --import tsx src/generate.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude tests/response-sweep.test.ts",
    "test:sweep": "vitest run tests/response-sweep.test.ts"
  },
  "dependencies": {
    "@sig-net/midnight-serde": "workspace:*"
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
