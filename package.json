{
  "name": "midnight-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sig Network on Midnight: the central signet contract, the client-agnostic protocol SDK, and a minimal test caller contract that exercises them end to end. Run `yarn compile` once before `build`/`test` — the contract packages and signet-midnight typecheck against the generated managed/ output.",
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0 --concurrency=auto",
    "lint:fix": "eslint . --fix --concurrency=auto",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile": "yarn workspaces foreach --all --exclude midnight-protocol --topological run compile",
    "compile:zk": "yarn workspaces foreach --all --exclude midnight-protocol --topological run compile:zk",
    "compile:test-caller-contract": "yarn workspace @midnight-protocol/test-caller-contract run compile",
    "compile:test-caller-contract:zk": "yarn workspace @midnight-protocol/test-caller-contract run compile:zk",
    "compile:test-caller-contract-20-field": "yarn workspace @midnight-protocol/test-caller-contract-20-field run compile",
    "deploy:test-caller-contract": "yarn workspace @midnight-protocol/test-caller-contract run deploy",
    "compile:signet-midnight": "yarn workspace @sig-net/midnight run compile",
    "test:signet-midnight": "yarn workspace @sig-net/midnight run test",
    "build:signet-midnight": "yarn workspace @sig-net/midnight run build",
    "build": "yarn workspaces foreach --all --exclude midnight-protocol --topological run build",
    "test": "yarn workspaces foreach --all --exclude midnight-protocol --topological run test",
    "test:integration-tests": "yarn workspace @midnight-protocol/integration-tests run test:integration",
    "test:integration-tests:signet-caller-e2e": "yarn workspace @midnight-protocol/integration-tests run test:integration:signet-caller-e2e",
    "test:integration-tests:signet-caller-evm-e2e": "yarn workspace @midnight-protocol/integration-tests run test:integration:signet-caller-evm-e2e",
    "compile:signet-contract": "yarn workspace @sig-net/midnight-contract run compile",
    "compile:signet-contract:zk": "yarn workspace @sig-net/midnight-contract run compile:zk",
    "test:signet-contract": "yarn workspace @sig-net/midnight-contract run test",
    "build:signet-contract": "yarn workspace @sig-net/midnight-contract run build",
    "deploy:signet-contract": "yarn workspace @sig-net/midnight-contract-deploy run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.26",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "resolutions": {
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2"
  }
}
